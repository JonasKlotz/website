---
---
<header class="site-nav fixed top-0 left-0 right-0 z-50 py-4 px-6 md:px-10">
  <div class="max-w-content mx-auto flex items-center justify-between" style="max-width:52rem">
    <a
      href="/"
      class="no-anim font-display text-xl font-semibold text-ink hover:opacity-60 transition-opacity duration-200"
      style="letter-spacing: -0.02em; text-decoration:none"
    >
      Jonas Klotz
    </a>
    <nav class="flex gap-6 font-mono text-xs font-medium uppercase tracking-widest" style="color:var(--ink-muted)">
      <a href="#publications" class="no-anim hover:text-amber transition-colors duration-200" style="text-decoration:none">Publications</a>
      <a href="#projects"     class="no-anim hover:text-amber transition-colors duration-200" style="text-decoration:none">Projects</a>
      <div class="relative group">
        <span class="cursor-default hover:text-amber transition-colors duration-200 flex items-center gap-1">
          Paper Sites
          <svg width="8" height="5" viewBox="0 0 8 5" fill="none" style="opacity:0.5;transition:transform 200ms" class="group-hover:rotate-180">
            <path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </span>
        <div class="absolute right-0 top-full pt-2 hidden group-hover:block" style="min-width:160px">
          <div class="rounded" style="background:var(--surface);border:1px solid var(--line);box-shadow:0 4px 16px rgba(0,0,0,0.08);padding:6px 0">
            <a
              href="/sae-metric"
              class="no-anim hover:text-amber transition-colors duration-200 block"
              style="text-decoration:none;padding:8px 16px;white-space:nowrap"
            >SAE-METRIC</a>
          </div>
        </div>
      </div>
      <a href="mailto:j.klotz@tu-berlin.de" class="no-anim hover:text-amber transition-colors duration-200" style="text-decoration:none">Contact</a>
    </nav>
  </div>
</header>

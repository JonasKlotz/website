<section class="max-w-content mx-auto px-6 md:px-10 pt-32 pb-20" style="max-width:52rem">
  <div class="flex flex-col sm:flex-row sm:items-start sm:gap-10 gap-8">

    <!-- Photo -->
    <div class="flex-none">
      <div class="w-28 h-28 sm:w-36 sm:h-36 overflow-hidden"
           style="border-radius:14px; box-shadow:0 8px 20px rgba(15,23,42,0.12)">
        <img
          src="/images/portrait.jpg"
          alt="Jonas Klotz"
          width="144"
          height="144"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Bio -->
    <div class="flex-1 min-w-0">
      <h1
        class="font-display font-semibold text-ink mb-1 reveal"
        style="font-size:clamp(2.2rem,4.5vw,3rem); letter-spacing:-0.03em; line-height:1.08"
      >
        Jonas Klotz
      </h1>
      <p class="font-mono text-xs uppercase tracking-widest mb-5 reveal"
         style="color:var(--ink-faint); letter-spacing:0.1em; animation-delay:60ms">
        PhD Student · BIFOLD / TU Berlin
      </p>
      <p class="font-sans text-sm text-ink-muted mb-6 reveal"
         style="line-height:1.8; max-width:34rem; animation-delay:120ms">
        I work at the intersection of
        <span class="font-semibold text-ink">remote sensing</span> and
        <span class="font-semibold text-ink">explainable AI</span>
        at the Berlin Institute for the Foundations of Learning and Data (<a href="https://www.bifold.berlin/people/jonas-klotz.html" target="_blank" rel="noopener" style="color:var(--primary)">BIFOLD</a>),
        Remote Sensing and Image Analysis (<a href="https://rsim.berlin" target="_blank" rel="noopener" style="color:var(--primary)">RSIM</a>) Group.
        I received my M.Sc. in Computer Science from TU Berlin in 2024.
      </p>
      <div class="flex flex-wrap gap-2 reveal-stagger">
        <a href="mailto:j.klotz@tu-berlin.de" class="link-btn no-anim">Email</a>
        <a href="https://scholar.google.de/citations?user=QrMeBpMAAAAJ&hl=en" target="_blank" rel="noopener" class="link-btn no-anim">Scholar</a>
        <a href="https://github.com/JonasKlotz" target="_blank" rel="noopener" class="link-btn no-anim">GitHub</a>
        <a href="https://www.linkedin.com/in/jonas-klotz/" target="_blank" rel="noopener" class="link-btn no-anim">LinkedIn</a>
      </div>
    </div>

  </div>
</section>

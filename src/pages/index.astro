---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const year = new Date().getFullYear();
const publications = (await getCollection('publications')).sort((a, b) => {
  const ao = a.data.order ?? 999, bo = b.data.order ?? 999;
  if (ao !== bo) return ao - bo;
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0);
});
const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.year - a.data.year
);
---
<Base>
  <Nav />
  <main>
    <Hero />

    <!-- Full-bleed section divider -->
    <div class="max-w-content mx-auto px-6 md:px-10" style="max-width:52rem">
      <div class="section-divider" />
    </div>

    <Section id="publications" title="Publications" wide={true}>
      {publications.map((pub) => <PublicationCard publication={pub} />)}
    </Section>

    <!-- Teaching -->
    <div class="max-w-content mx-auto px-6 md:px-10" style="max-width:52rem">
      <div class="section-divider" />
    </div>
    <Section id="teaching" title="Teaching">
      <!-- Courses -->
      <div class="reveal">
        <p class="teaching-sub">Courses</p>
        <div>
          <div class="teaching-row">
            <span class="teaching-semester">WiSe 2024/25</span>
            <div>
              <div class="teaching-title">Project Computer Vision for Remote Sensing</div>
              <div class="teaching-detail">Project supervision <span class="teaching-count">2 students</span></div>
            </div>
          </div>
          <div class="teaching-row">
            <span class="teaching-semester">SoSe 2025</span>
            <div>
              <div class="teaching-title">Image Processing and Learning for Earth Observation</div>
              <div class="teaching-detail">Practical labs · Amazon deforestation mini-project <span class="teaching-count">50 students</span></div>
            </div>
          </div>
          <div class="teaching-row">
            <span class="teaching-semester">2025 Cremona</span>
            <div>
              <div class="teaching-title">EO Winter School — Lab on Self-Supervised Learning</div>
              <div class="teaching-detail">Cremona, Italy <span class="teaching-count">15 students</span></div>
            </div>
          </div>
          <div class="teaching-row">
            <span class="teaching-semester">SoSe 2026</span>
            <div>
              <div class="teaching-title">Image Processing and Learning for Earth Observation</div>
              <div class="teaching-detail">Practical labs · Amazon deforestation mini-project <span class="teaching-count">40 students</span></div>
            </div>
          </div>
        </div>
      </div>

      {/* Thesis supervision — hidden for now
      <div class="reveal" style="margin-top:2.25rem">
        <p class="teaching-sub">Thesis Supervision</p>
        <div>
          <div class="thesis-row">
            <span class="thesis-student"><span class="teaching-semester">2026</span></span>
            <p class="thesis-title-text">Analysis of Federated Prompt Learning Methods for Remote Sensing: Leveraging Token Relevance for Efficient Prompt Aggregation</p>
          </div>
          <div class="thesis-row">
            <span class="thesis-student"><span class="teaching-semester">2026</span></span>
            <p class="thesis-title-text">Towards Reliable Explanation Methods and Metrics for Remote Sensing Image Scene Classification</p>
          </div>
        </div>
      </div>
      */}
    </Section>

    {projects.length > 0 && (
      <Fragment>
        <div class="max-w-content mx-auto px-6 md:px-10" style="max-width:52rem">
          <div class="section-divider" />
        </div>
        <Section id="projects" title="Projects" wide={true}>
          {projects.map((proj) => <ProjectCard project={proj} />)}
        </Section>
      </Fragment>
    )}
  </main>

  <div class="max-w-content mx-auto px-6 md:px-10" style="max-width:52rem">
    <div class="section-divider" />
  </div>
  <footer
    class="max-w-content mx-auto px-6 md:px-10 py-8 flex flex-wrap items-center justify-between gap-4"
    style="max-width:52rem"
  >
    <p class="font-mono text-xs" style="color:var(--ink-faint); letter-spacing:0.06em">
      © {year} Jonas Klotz
    </p>
    <nav class="flex gap-5 font-mono text-xs" style="color:var(--ink-faint);letter-spacing:0.06em">
      <a href="/impressum" class="no-anim hover:text-amber transition-colors duration-200" style="color:var(--ink-faint);text-decoration:none">Impressum</a>
      <a href="/datenschutz" class="no-anim hover:text-amber transition-colors duration-200" style="color:var(--ink-faint);text-decoration:none">Datenschutz</a>
    </nav>
  </footer>
</Base>
